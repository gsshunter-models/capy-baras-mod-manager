<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net9.0-windows</TargetFramework><UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><AssemblyName>CapyBaraModManager</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest><Version>1.4.0</Version>
    <Product>Capy Bara's Mod Manager</Product><Title>Capy Bara's Mod Manager</Title><Description>Capybara and orange themed mod manager for MX Simulator.</Description>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Core/MXSimModManager.Core.csproj" /></ItemGroup>
  <ItemGroup><Resource Include="app.ico" /></ItemGroup>
  <ItemGroup><Resource Include="Assets/capybara-orange.png" /></ItemGroup>
  <ItemGroup><PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" /></ItemGroup>
  <ItemGroup><None Include="../licenses/**/*" Link="licenses/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
