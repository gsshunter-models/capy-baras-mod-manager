<Window x:Class="MXSimModManager.Desktop.AppearanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rider and bike appearance — Capy Bara's Mod Manager" Icon="app.ico" Width="1160" Height="810" MinWidth="990" MinHeight="700"
        WindowStartupLocation="CenterOwner" Background="#14120F" Foreground="#F5EFDF"
        FontFamily="Segoe UI" FontSize="13" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F5EFDF"/></Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#332B20"/><Setter Property="Foreground" Value="#F5EFDF"/><Setter Property="BorderBrush" Value="#4C4030"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="12,9"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#FFAB49"/><Setter Property="Foreground" Value="#2D1C0B"/><Setter Property="BorderBrush" Value="#FFAB49"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F5EFDF"/><Setter Property="Background" Value="#191610"/><Setter Property="BorderBrush" Value="#4C4030"/><Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="#FFAB49"/><Setter Property="SelectionBrush" Value="#765330"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="11,10"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="Foreground" Value="#F5EFDF"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#382E20"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#4A3520"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#F5EFDF"/><Setter Property="Background" Value="#191610"/><Setter Property="BorderBrush" Value="#4C4030"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="IsEditable" Value="True"/><Setter Property="IsTextSearchEnabled" Value="True"/><Setter Property="StaysOpenOnEdit" Value="True"/><Setter Property="MaxDropDownHeight" Value="310"/><Setter Property="MinHeight" Value="39"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/><Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/><Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ItemsPanel"><Setter.Value><ItemsPanelTemplate><VirtualizingStackPanel/></ItemsPanelTemplate></Setter.Value></Setter>
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F5EFDF"/><Setter Property="Background" Value="#28231B"/><Setter Property="Padding" Value="11,8"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter><Style.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter Property="Background" Value="#51402B"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#FFAB49"/></Trigger></Style.Triggers></Style></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"/>
                    <TextBox x:Name="PART_EditableTextBox" Background="Transparent" BorderThickness="0" Padding="0" Margin="11,7,36,7" VerticalContentAlignment="Center" IsReadOnly="{TemplateBinding IsReadOnly}"/>
                    <ToggleButton Focusable="False" Width="31" HorizontalAlignment="Right" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Margin="0,1,1,1">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#332B20" CornerRadius="0,6,6,0"><Path Data="M 0 0 L 4 4 L 8 0" Stroke="#BEAD90" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#28231B" BorderBrush="#5B4C38" BorderThickness="1" CornerRadius="6" MinWidth="{TemplateBinding ActualWidth}" MaxWidth="760" MaxHeight="{TemplateBinding MaxDropDownHeight}" Padding="3"><ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
        <Style x:Key="FieldHelp" TargetType="TextBlock"><Setter Property="Foreground" Value="#A49680"/><Setter Property="FontSize" Value="10"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Margin" Value="0,7,0,0"/></Style>
    </Window.Resources>
    <Grid Margin="25">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Rider &amp; bike appearance" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Pick a complete look from your installed mods." Foreground="#B6AA98" Margin="1,7,0,0"/></StackPanel><Button Grid.Column="1" Content="Rescan installed assets" Click="Rescan_Click" VerticalAlignment="Center"/></Grid>
        <Border Grid.Row="1" Background="#2A2D1D" BorderBrush="#465135" BorderThickness="1" CornerRadius="8" Padding="13,11" Margin="0,0,0,17"><TextBlock Text="Apply writes saved game settings while MX Simulator is closed and creates a backup. While playing, save an appearance preset and use its game load command." Foreground="#C1CBA8" TextWrapping="Wrap" FontSize="12" LineHeight="18"/></Border>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="17"/><ColumnDefinition Width="295"/></Grid.ColumnDefinitions>
            <Border Background="#211E18" BorderBrush="#40372A" BorderThickness="1" CornerRadius="9" Padding="20">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,19"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="YOUR SELECTION" Foreground="#FFAB49" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Type the start of a name to jump to it." Foreground="#A49680" FontSize="11" Margin="0,7,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding DirtyText}" Foreground="#FFAB49" FontSize="11" VerticalAlignment="Center"/></Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,0,6,0">
                        <StackPanel Margin="0,0,0,22"><TextBlock Text="Bike model / dyno" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="BikeCombo" ItemsSource="{Binding BikeOptions}" SelectedItem="{Binding SelectedBike, Mode=TwoWay}" DisplayMemberPath="Label" TextSearch.TextPath="Label" AutomationProperties.Name="Bike model or dyno"/><TextBlock Text="Choose the bike first to see its compatible skins." Style="{StaticResource FieldHelp}"/></StackPanel>
                        <StackPanel Margin="0,0,0,22"><TextBlock Text="Bike skin" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="BikeSkinCombo" ItemsSource="{Binding BikeSkinOptions}" SelectedItem="{Binding SelectedBikeSkin, Mode=TwoWay}" DisplayMemberPath="Label" TextSearch.TextPath="Label" AutomationProperties.Name="Bike skin"/></StackPanel>
                        <StackPanel Margin="0,0,0,22"><TextBlock Text="Helmet" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="HelmetCombo" ItemsSource="{Binding HelmetOptions}" SelectedItem="{Binding SelectedHelmet, Mode=TwoWay}" DisplayMemberPath="Label" TextSearch.TextPath="Label" AutomationProperties.Name="Helmet"/></StackPanel>
                        <StackPanel Margin="0,0,0,22"><TextBlock Text="Gear" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="GearCombo" ItemsSource="{Binding GearOptions}" SelectedItem="{Binding SelectedGear, Mode=TwoWay}" DisplayMemberPath="Label" TextSearch.TextPath="Label" AutomationProperties.Name="Rider gear"/></StackPanel>
                        <StackPanel Margin="0,0,0,10"><TextBlock Text="Wheels" Style="{StaticResource FieldLabel}"/><ComboBox x:Name="WheelsCombo" ItemsSource="{Binding WheelsOptions}" SelectedItem="{Binding SelectedWheels, Mode=TwoWay}" DisplayMemberPath="Label" TextSearch.TextPath="Label" AutomationProperties.Name="Wheels"/></StackPanel>
                    </StackPanel></ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="0,18,0,0"><TextBlock Text="{Binding ContentSummary}" Foreground="#A49680" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,12"/><Button Content="Apply to saved game settings…" Style="{StaticResource PrimaryButton}" Click="Apply_Click"/><TextBlock Text="{Binding GameStatusText}" Foreground="#B6AA98" FontSize="11" Margin="0,9,0,0" TextWrapping="Wrap"/></StackPanel>
                </Grid>
            </Border>
            <Border Grid.Column="2" Background="#211E18" BorderBrush="#40372A" BorderThickness="1" CornerRadius="9" Padding="17">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,14"><TextBlock Text="APPEARANCE PRESETS" Foreground="#FFAB49" FontSize="10" FontWeight="SemiBold"/><TextBlock Text="Save looks and load them in the game." Foreground="#B6AA98" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
                    <ListBox x:Name="PresetList" Grid.Row="1" ItemsSource="{Binding Presets}" SelectedItem="{Binding SelectedPreset, Mode=TwoWay}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Details}" Foreground="#B6AA98" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <StackPanel Grid.Row="2" Margin="0,14,0,0"><Button Content="Save selection as preset…" Click="SavePreset_Click" Margin="0,0,0,8"/><Button Content="Load selected into editor" Click="LoadPreset_Click" IsEnabled="{Binding HasPreset}" Margin="0,0,0,8"/><Button Content="Copy game load command" Click="CopyCommand_Click" IsEnabled="{Binding HasPreset}" Margin="0,0,0,8"/><TextBlock Text="{Binding PresetNote}" Foreground="#A49680" FontSize="10" TextWrapping="Wrap" LineHeight="16"/><Border Height="1" Background="#453A2B" Margin="0,17"/><Button Content="Read saved appearance" Click="ReadCurrent_Click" FontSize="11" Margin="0,0,0,8"/><Button Content="Restore config backup…" Click="RestoreBackup_Click" FontSize="11"/><TextBlock Text="Load a command in game: press T, paste, then Enter. New mod files may still need a game restart." Foreground="#A49680" FontSize="10" TextWrapping="Wrap" LineHeight="16" Margin="0,11,0,0"/></StackPanel>
                </Grid>
            </Border>
        </Grid>
        <TextBlock Grid.Row="3" Text="{Binding StatusText}" Foreground="#C0B29B" FontSize="11" TextWrapping="Wrap" Margin="1,14,0,0"/>
    </Grid>
</Window>
