<Window x:Class="MXSimModManager.Desktop.ForumWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Forum tracks — Capy Bara's Mod Manager" Icon="app.ico" Width="1390" Height="900" MinWidth="1060" MinHeight="700" WindowStartupLocation="CenterOwner" Background="#14120F" Foreground="#F5EFDF" FontFamily="Segoe UI" Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F5EFDF"/></Style>
        <Style TargetType="Button"><Setter Property="Foreground" Value="#F5EFDF"/><Setter Property="Background" Value="#332B20"/><Setter Property="BorderBrush" Value="#4C4030"/><Setter Property="Padding" Value="12,8"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.35"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F5EFDF"/><Setter Property="Background" Value="#1A1712"/><Setter Property="BorderBrush" Value="#4C4030"/><Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="#FFAB49"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
        <Style TargetType="ListBoxItem"><Setter Property="Foreground" Value="#F5EFDF"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="10,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Surface" Background="#282219" Padding="{TemplateBinding Padding}" CornerRadius="6" Margin="0,0,0,7"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="Surface" Property="Background" Value="#4A3520"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,15"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="490"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Find your next track" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="Source: forum.mxsimulator.com — download a release, then review and install." TextWrapping="Wrap" Foreground="#C0B29B" Margin="0,6,12,0"/></StackPanel><DockPanel Grid.Column="1" VerticalAlignment="Center"><Button DockPanel.Dock="Right" Content="Bing" Click="AlternateSearch_Click" ToolTip="Alternative search restricted to MX Simulator forum posts" Margin="6,0,0,0"/><Button DockPanel.Dock="Right" Content="Search forum" Click="Search_Click" ToolTip="Search forum.mxsimulator.com posts using Google" Margin="8,0,0,0"/><TextBox x:Name="SearchBox" ToolTip="Find forum track releases. Google and Bing searches are restricted to forum.mxsimulator.com." AutomationProperties.Name="Search forum tracks" KeyDown="Search_KeyDown"/></DockPanel></Grid>
        <Grid Grid.Row="1" Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button x:Name="BackButton" Content="←" Click="Back_Click" ToolTip="Back" Margin="0,0,5,0"/><Button x:Name="ForwardButton" Content="→" Click="Forward_Click" ToolTip="Forward" Margin="0,0,5,0"/><Button Content="Tracks" Click="Home_Click" Margin="0,0,5,0"/><Button Content="Reload" Click="Reload_Click" Margin="0,0,9,0"/></StackPanel><TextBox x:Name="AddressBox" Grid.Column="1" KeyDown="Address_KeyDown" AutomationProperties.Name="Forum or download address"/><Button Grid.Column="2" Content="Go" Click="Go_Click" Margin="8,0,0,0"/></Grid>
        <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border Background="#211E18" BorderBrush="#40372A" BorderThickness="1" CornerRadius="7"><wv:WebView2 x:Name="Browser" DefaultBackgroundColor="White"/></Border>
            <Border Grid.Column="2" Background="#211E18" BorderBrush="#40372A" BorderThickness="1" CornerRadius="8" Padding="14"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="0,0,0,13"><TextBlock Text="DOWNLOADS" Foreground="#FFAB49" FontSize="11" FontWeight="SemiBold"/><CheckBox x:Name="DirectLinksBox" Content="Skip download pages" IsChecked="True" Foreground="#F5EFDF" Margin="0,12,0,9" ToolTip="Download public MediaFire, MEGA, Dropbox and archive links directly."/><Button Content="Paste download link…" Click="PasteDownload_Click"/><TextBlock Text="Public MediaFire · MEGA · Dropbox · archive links" Foreground="#C0B29B" FontSize="10" TextWrapping="Wrap" Margin="0,9,0,0"/></StackPanel>
                <ListBox x:Name="DownloadList" Grid.Row="1" ItemsSource="{Binding Downloads}" SelectionChanged="DownloadList_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding Host}" Foreground="#AA987E" FontSize="10" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/><ProgressBar Value="{Binding Percent, Mode=OneWay}" Height="3" Margin="0,10,0,8" Foreground="#FFAB49" Background="#40372A"/><TextBlock Text="{Binding State}" Foreground="#C9BDA7" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding SizeText}" Foreground="#AA987E" FontSize="10" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                <StackPanel Grid.Row="2" Margin="0,14,0,0"><Button x:Name="InstallButton" Content="Install selected…" Background="#FFAB49" Foreground="#2D1C0B" Click="Install_Click" IsEnabled="False"/><Button x:Name="CancelButton" Content="Cancel download" Click="Cancel_Click" IsEnabled="False" Margin="0,8,0,0"/><Button x:Name="OpenPageButton" Content="Open download page" Click="OpenDownloadPage_Click" IsEnabled="False" Margin="0,8,0,0" FontSize="11"/><Button Content="Open downloads folder" Click="OpenDownloads_Click" Margin="0,8,0,0" FontSize="11"/><TextBlock Text="ZIP · SAF · RAR · 7z" Foreground="#C0B29B" FontSize="11" Margin="0,15,0,7"/><TextBlock Text="Every installation has a preview and undo. New content may need a game restart. Use Open download page for links that need a login, password or host download steps." Foreground="#AA987E" FontSize="10" TextWrapping="Wrap" LineHeight="16"/></StackPanel>
            </Grid></Border>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Text="Starting the forum browser…" Foreground="#C0B29B" Margin="0,13,0,0" FontSize="11" TextWrapping="Wrap"/>
    </Grid>
</Window>
